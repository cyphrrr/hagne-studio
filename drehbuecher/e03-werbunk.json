 "dialog": [
  {"von": 0.92, "bis": 2.94, "wer": "ds", "text": "Willkommen auf der Junien in Hagen.", "blase": [0.87, 3.39]},
  {"von": 6.82, "bis": 7.9, "wer": "ds", "text": "Wir sind die Besten.", "blase": [6.77, 8.35]},
