  {"von": 27.04, "bis": 28.06, "wer": "ds", "text": "Ganz viel Spaß.", "blase": [26.99, 28.51]},
  {"von": 31.12, "bis": 32.32, "wer": "ds", "text": "Komm auch du zur Junien.", "blase": [31.07, 32.43]},
